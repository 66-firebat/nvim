local function statusBorderBump()
  local cursorline = vim.fn.line(".")
  if vim.v.lnum == cursorline then
    return "%#StatusColumnBorder#┣ "
  else
    return "%#StatusColumnBorder#┃ "
  end
end


local function lineHighlight()
  local cursorline = vim.fn.line(".")
  if vim.v.lnum == cursorline then
    return "%#CursorLineNr#"
  else
    return "%#StatusColumnPlugin#"
  end
end

local function noHighlight()
  local cursorline = vim.fn.line(".")
  if vim.v.lnum == cursorline then
    return "%#CursorLineNr#"
  else
    return "%#StatusColumnPlugin#"
  end
end

local function gitHighlight()
  local cursorline = vim.fn.line(".")
  -- local gitsigns = require("gitsigns")
  -- local hunk = gitsigns.get_hunk()
  if vim.v.lnum == cursorline then
    vim.api.nvim_set_hl(0, 'SignColumn', { fg = 'none', bg = '#ff6000' })
    return "%s"
  else
    vim.api.nvim_set_hl(0, 'SignColumn', { fg = 'none', bg = '#80401a' })
    return "%s"
  end
end

return {
  "luukvbaal/statuscol.nvim", config = function()
    local builtin = require("statuscol.builtin")
    require("statuscol").setup({
      -- configuration goes here, for example:
      relculright = true,
      segments = {
        -- { text = { builtin.foldfunc }, click = "v:lua.ScFa" },
        -- { text = {"%#StatusColumnBorder#%s" }, click = "v:lua.ScSa", hl = "Monoglow" },
        -- { text = { "%#StatusCol# %s" }},
        { text = { "%#StatusCol# " }},
        {
          sign = {
            namespace = { "gitsigns" }, -- Targets the marks namespace
            maxwidth = 1,
            colwidth = 1,
            auto = false -- Set to true if you want it to disappear when no marks exist
          },
          hl = "CursorLineNr"
        },
        { text = { "%#StatusCol# " }},
        { text = { lineHighlight, builtin.lnumfunc, ' '} },
        {
          sign = {
            name = { ".*" }, -- Targets the marks namespace
            maxwidth = 1,
            colwidth = 1,
            auto = false -- Set to true if you want it to disappear when no marks exist
          },
          -- text = { "%#StatusCol#" },
        },
        { text = {statusBorderBump}, hl = "MonoGlowStatusColumnBorder" },
        -- {
          --   sign = { name = { ".*" }, maxwidth = 2, colwidth = 1, auto = true, wrap = true },
          --   click = "v:lua.ScSa"
          -- },
        }
      })
    end,
  }


  -- vim.o.statuscolumn = '%= %{%v:lnum %} %#StatusColumnBorder#▍%s'
